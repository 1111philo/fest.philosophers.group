---
// The NOAI Manifesto - a poem set as one justified column of big type,
// stanza by stanza, in the site's grotesk. Color follows three rules:
//   plates (solid fills) - the people, and the closing call;
//   yellow highlight     - the thesis, once;
//   blue text            - the thread of truth: divinity, the clarinet's
//                          tone, the renaissance.
// Everything else is ink: heavy for claims, light for narrative.
import PageLayout from '../layouts/PageLayout.astro';
import { SITE_URL, SITE_TITLE, SITE_IMAGE } from '../lib/content.mjs';

const meta = {
  title: `The NOAI Manifesto — ${SITE_TITLE}`,
  description: 'The greatest New Orleanians never asked permission. The age of AI can be a renaissance, but Silicon Valley can’t build it alone.',
  canonical: `${SITE_URL}/manifesto/`,
  image: SITE_IMAGE.url,
};
---
<PageLayout title={meta.title} description={meta.description} canonical={meta.canonical} image={meta.image} current="">
  <link slot="head" href="https://fonts.googleapis.com/css2?family=Inter+Tight:ital,wght@1,400;1,700&display=swap" rel="stylesheet">
  <article class="mf" aria-labelledby="mf-title">
    <header class="mf-head">
      <h1 class="mf-title" id="mf-title">The NOAI Manifesto</h1>
      <span class="mf-rule" aria-hidden="true"><span class="mf-blue"></span><span class="mf-red"></span><span class="mf-yellow"></span><span class="mf-teal"></span></span>
    </header>

    <div class="mf-text">
      <p class="mf-names"><span class="mf-plate mf-blue">Louis Armstrong.</span> <span class="mf-plate mf-red">Huey P. Long.</span> <span class="mf-plate mf-yellow">Paul Morphy.</span> <span class="mf-plate mf-teal">Master P.</span></p>
      <p>The greatest New Orleanians <span class="mf-highlight">never asked permission.</span></p>
      <p><span class="mf-quiet"><b>Armstrong</b> gave jazz to the world. <b>Morphy</b> beat Europe at 21. <b>Long</b> made every man a king, every woman a queen. <b>Master P</b> turned the projects into a hip-hop empire.</span> No one signed off. They built.</p>
      <p>We are their heirs. <span class="mf-quiet">Scrappy. Under-resourced.</span> Chasing one thing: <span class="mf-truth mf-spelled"><span class="sr-only">divinity.</span><span aria-hidden="true">{[...'divinity'].map((ch, i) => <>{i > 0 && <span class="mf-dot">&bull;</span>}{ch}</>)}.</span></span></p>
      <p><span class="mf-quiet">The Renaissance masters chased it too. <em>Michelangelo&rsquo;s hand of God. Galileo&rsquo;s falling bodies.</em></span> Truth beyond art, beyond reason:</p>
      <p class="mf-truth"><em>A clarinet&rsquo;s long tone, drifting through the mist of a French Quarter morning.</em></p>
      <p>The age of AI can be a <span class="mf-truth">renaissance.</span> But Silicon Valley&rsquo;s coders and their venture funders <span class="mf-plate mf-red">can&rsquo;t build it alone.</span></p>
    </div>

    <div class="page-cta-row">
      <a class="btn-primary" href="/register/">Register for NOAI 2026</a>
      <a class="btn-outline" href="/about/">About the Festival</a>
    </div>
  </article>
</PageLayout>

---
import PageLayout from '../../layouts/PageLayout.astro';
import PageHero from '../../components/PageHero.astro';
import { SITE_URL, SITE_TITLE, SITE_IMAGE } from '../../lib/content.mjs';

const meta = {
  title: `You're Registered — ${SITE_TITLE}`,
  description: 'Thank you for registering for NOAI: Arts & Ideas Festival in New Orleans.',
  canonical: `${SITE_URL}/register/thank-you/`,
  image: SITE_IMAGE.url,
};
---
<PageLayout title={meta.title} description={meta.description} canonical={meta.canonical} image={meta.image} current="register">
  <PageHero slot="hero" label="Registration confirmed" eyebrow="Registration" title="You’re registered!" accent="yellow" art="field" />
  <p class="page-lede">
    Thanks for signing up for NOAI: Arts &amp; Ideas Festival. A receipt is on its way to your
    inbox from Stripe. We&rsquo;ll follow up by email with more details as the festival gets closer.
  </p>
  <div class="page-cta-row">
    <a class="btn-primary" href="/">View the Schedule</a>
    <a class="btn-outline" href="/about/">Learn More</a>
  </div>
</PageLayout>

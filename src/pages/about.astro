---
import PageLayout from '../layouts/PageLayout.astro';
import PageHero from '../components/PageHero.astro';
import { loadContent, pageMeta, SITE_TITLE, SITE_IMAGE } from '../lib/content.mjs';

const meta = pageMeta(loadContent(), 469, 'about');
meta.title = `About — ${SITE_TITLE}`;
meta.image = SITE_IMAGE;
meta.description = 'Philosophy, Philanthropy, Tech, Biz, and Education. Learn about NOAI: Arts & Ideas Festival in New Orleans, and the 11:11 Philosophers Group.';

const TIMES_PICAYUNE_URL = 'https://web.archive.org/web/20250821094845/https://www.nola.com/news/business/innovation/noai-new-orleans-jazz-museum-1111-philosophers-artificial-intelligence-blake-grace-bertuccelli-booth/article_3eddfcb0-9acd-11ef-97c3-1bbd0c95b721.html';
const HERO_IMAGE = '/media/560-DSC2694.jpg';
const SLACK_INVITE_URL = 'https://join.slack.com/t/1111philo/shared_invite/zt-2gmnevnx3-qR6119iBjUFxS4BgP8wXzA';

// Every project's own real, currently-live URL (verified against
// philosophers.group directly, not guessed) - AI for Every Student links
// internally since this same site already hosts that page.
const PROJECTS = [
  {
    name: 'AI for Every Student',
    url: '/ai-for-every-student/',
    external: false,
    body: 'Bringing AI literacy, coaching, and tools into Louisiana K-12 classrooms.',
  },
  {
    name: 'AI Leaders',
    url: 'https://ai-leaders.org/',
    external: true,
    body: "A fully agentic course on AI literacy and enablement. Its first cohort graduated 36 finalists from over 500 applicants, with partners including Automattic and the University of Illinois Chicago.",
  },
  {
    name: 'Equalify Iris',
    url: 'https://github.com/equalifyEverything/equalify-iris',
    external: true,
    body: 'An open-source tool that converts PDFs into accessible HTML for blind and low-vision readers.',
  },
  {
    name: 'plato',
    url: 'https://philosophers.group/plato-agentic-classroom/',
    external: true,
    body: 'An open-source, AI-powered agentic classroom platform.',
  },
];

// The founding conversation, as data so each speaker gets their own
// color block in the dialogue layout instead of repeating markup per line.
const FOUNDING_DIALOGUE = [
  ['Blake', 'I wish I could talk about ideas with folks in New Orleans.'],
  ['Grace', 'Why not talk with me?'],
  ['Blake', 'Bertrand Russell says we need to care about a larger social unit outside of our family.'],
  ['Grace', 'Why not start a group?'],
  ['Blake', 'Good \u2014 I\u2019ll write a manifesto.'],
  ['Grace', 'Just email some friends.'],
  ['Blake', 'Brilliant.'],
  ['Grace', 'What time should we have it?'],
  ['Blake', 'It needs to be on Sundays \u2014 like a religious community. After Catholic Mass, but while we can still drink cappuccinos.'],
  ['Grace', '11:11?'],
  ['Blake', 'Brilliant!'],
];

const STATS = [
  { num: '2021', label: '11:11 Founded' },
  { num: '2023', label: 'First Festival' },
  { num: '$333k', plus: true, label: 'Directed to Causes' },
  { num: '155', plus: true, label: 'Talks Since 2023' },
];

const GALLERY = [
  { src: '/media/557-DSC0995.jpg', alt: 'A woman speaks into a microphone. She appears to be on a panel, sitting next to another woman.' },
  { src: '/media/558-DSC1406.jpg', alt: 'A male panelist in the center of the frame speaks to a man on his left, while another man listens on his right.' },
  { src: '/media/559-DSC1915.jpg', alt: 'A female speaker is speaking into a microphone. She appears to be mid-sentence.' },
  { src: '/media/562-DSC1744.jpg', alt: 'A man speaks into a microphone. On his head is a brain-scan looking device.' },
  { src: '/media/563-IMG_0771-scaled.jpeg', alt: 'A speaker stands with her hand to a laptop. Behind her is a screen with a slide showing two photographs, slightly out of focus.' },
  { src: '/media/566-DSC2323-2.jpg', alt: 'A panelist is mid-sentence, seeming to explain something.' },
  { src: '/media/565-DSC3121.jpg', alt: 'An electronic musician, painted in neon ink, turns knobs on his instrument.' },
];
---
<PageLayout title={meta.title} description={meta.description} canonical={meta.canonical} image={meta.image.url} current="about">
  <PageHero
    slot="hero"
    label="About the festival"
    eyebrow="About the Festival"
    title="Philosophy, Philanthropy, Tech, Biz & Education"
    image={HERO_IMAGE}
    accent="blue"
  />

  <section class="swiss-split" aria-labelledby="about-festival">
    <p class="section-index" aria-hidden="true">01</p>
    <div class="swiss-split-body">
      <h2 class="page-section-heading" id="about-festival">The Festival</h2>
      <p class="page-lede">
        NOAI is a global stage for creative and driven professionals
        who want to change the world. Organized by the <a href="https://philosophers.group" target="_blank" rel="noopener">11:11 Philosophers Group<span class="sr-only"> (opens in a new window)</span></a>,
        the festival includes conversations, presentations, and performances that bring New Orleans into
        conversation with cutting-edge, impact-driven work.
      </p>
      <p class="theme-statement">
        Each year, NOAI changes its theme. For 2026, the AI of NOAI is <span class="theme-highlight">Arts &amp; Ideas</span>.
      </p>
      <div class="page-cta-row">
        <a class="btn-primary" href="https://buy.stripe.com/9B6cN4dvP13b6d97BQ7Zu06" target="_blank" rel="noopener">
          Donate<span class="sr-only"> (opens in a new window)</span>
        </a>
        <a class="btn-outline" href="mailto:fest@philosophers.group?subject=Presentation%20Submission">
          Propose a Presentation
        </a>
        <a class="btn-outline" href="/">View the Schedule</a>
      </div>
    </div>
  </section>

  <ul class="about-stats" aria-label="By the numbers">
    {STATS.map((stat) => (
      <li class="about-stat">
        <p class="about-stat-num">{stat.num}{stat.plus && <span class="stat-plus">+</span>}</p>
        <p class="about-stat-label">{stat.label}</p>
      </li>
    ))}
  </ul>

  <a class="manifesto-banner" href="/manifesto/">
    <span class="manifesto-banner-quote">&ldquo;The greatest New Orleanians never asked permission.&rdquo;</span>
    <span class="manifesto-banner-cta">Read the NOAI Manifesto <span aria-hidden="true">&rarr;</span></span>
  </a>

  <section class="page-block" aria-labelledby="about-gallery">
    <div class="section-head">
      <p class="section-index" aria-hidden="true">02</p>
      <h2 class="page-section-heading" id="about-gallery">Celebrating Arts &amp; Ideas Since 2023</h2>
    </div>
    <div class="page-gallery">
      {GALLERY.map((img) => (
        <img src={img.src} alt={img.alt} loading="lazy" />
      ))}
    </div>
  </section>

  <section class="page-block" aria-labelledby="about-group">
    <div class="section-head">
      <p class="section-index" aria-hidden="true">03</p>
      <h2 class="page-section-heading" id="about-group">The Group Behind It</h2>
    </div>
    <div class="about-org">
      <div class="about-org-text">
        <p>
          NOAI is organized by the <a href="https://philosophers.group" target="_blank" rel="noopener">11:11 Philosophers Group<span class="sr-only"> (opens in a new window)</span></a>,
          a community whose guiding question is simple: how do we do good better? It started as a Sunday
          habit &mdash; in October 2021, Blake and Grace Bertuccelli-Booth decided New Orleans needed a
          place to talk about ideas. Here&rsquo;s how that founding conversation went:
        </p>
        <blockquote class="about-quote">
          {FOUNDING_DIALOGUE.map(([who, line]) => (
            <p class={`about-quote-line about-quote-${who.toLowerCase()}`}>
              <strong>{who}:</strong> <span>&ldquo;{line}&rdquo;</span>
            </p>
          ))}
          <p class="about-quote-cap">&hellip;and so 11:11 was born.</p>
        </blockquote>
        <p>
          The first meeting, at Petite Clouet caf&eacute; on October 21, 2021, drew an artist, an AI
          developer, and a few curious neighbors. Weekly meetings ran for years afterward &mdash; and
          anyone can still join. 1111&rsquo;s meetings and Slack are open to whoever wants in.
        </p>
        <div class="page-cta-row">
          <a class="btn-outline" href="https://philosophers.group" target="_blank" rel="noopener">
            Visit philosophers.group<span class="sr-only"> (opens in a new window)</span>
          </a>
          <a class="btn-outline" href={SLACK_INVITE_URL} target="_blank" rel="noopener">
            Join the 11:11 Slack<span class="sr-only"> (opens in a new window)</span>
          </a>
        </div>
      </div>
      <figure class="about-org-photo">
        <div class="framed-photo framed-photo-yellow">
          <img
            src="/media/1111-origin-story.jpg"
            alt="Artist Robert Tannen, wearing a yellow beanie, holds up a hand-lettered sign at 11:11's first meeting outside a New Orleans shotgun house."
            loading="lazy"
          />
        </div>
        <figcaption>11:11&rsquo;s first meeting, October 21, 2021.</figcaption>
      </figure>
    </div>
  </section>

  <section class="page-block" aria-labelledby="about-projects">
    <div class="section-head">
      <p class="section-index" aria-hidden="true">04</p>
      <h2 class="page-section-heading" id="about-projects">More From 11:11</h2>
    </div>
    <p class="page-lede">
      The festival is one of several 11:11 projects working on accessible, evidence-based ways to do good better:
    </p>
    <ol class="org-project-list">
      {PROJECTS.map((p) => (
        <li>
          <a class="org-project-row" href={p.url} target={p.external ? '_blank' : undefined} rel={p.external ? 'noopener' : undefined}>
            <span class="org-project-name">{p.name}<span class="sr-only">: </span></span>
            <span class="org-project-body">{p.body}{p.external && <span class="sr-only"> (opens in a new window)</span>}</span>
            <span class="org-project-arrow" aria-hidden="true">&rarr;</span>
          </a>
        </li>
      ))}
    </ol>
  </section>

  <a class="press-banner" href={TIMES_PICAYUNE_URL} target="_blank" rel="noopener">
    <span class="press-banner-source">Times-Pic article</span>
    <span class="press-banner-cta">Read the feature <span aria-hidden="true">&rarr;</span><span class="sr-only"> (opens in a new window)</span></span>
  </a>
</PageLayout>

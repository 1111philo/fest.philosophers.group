---
import PageLayout from '../../layouts/PageLayout.astro';
import { SITE_URL, SITE_TITLE } from '../../lib/content.mjs';

const title = `AI for Every Student — ${SITE_TITLE}`;
const description = "Graduate Louisiana's 650,000+ digital citizens ready to win the $4.4 Trillion AI Tech future. AI for Every Student brings AI literacy, coaching, and tools into K-12 classrooms.";
const canonical = `${SITE_URL}/ai-for-every-student/`;
const image = `${SITE_URL}/media/ogg-arts.png`;
const HERO_IMAGE = '/media/ai-fes-classroom.jpg';

const FUNDERS = [
  'Walter Isaacson', 'Matt Mullenweg', 'the Kirin Family', 'Renée & Stewart Peck',
  'Louisiana Economic Development (LED)', '11:11 Philosophers Group',
];

// Each initiative's own real partner logo, downloaded from
// noai.philosophers.group (the org's prior site for this same program).
const INITIATIVES = [
  {
    name: 'AI Literacy Education',
    logo: '/media/ai-fes-logo-stem-nola.png',
    logoAlt: 'STEM NOLA logo',
    body: 'NOAI and STEM NOLA developed the AI Futures workshop, increasing AI literacy for monthly high school student cohorts throughout Louisiana.',
  },
  {
    name: 'AI Playbook and Professional Development at Ben Franklin',
    logo: '/media/ai-fes-logo-ben-franklin.png',
    logoAlt: 'Benjamin Franklin High School logo',
    body: '$13,000 funded a year-long AI initiative at Benjamin Franklin High School, led by teacher Rebecca Gaillot, resulting in school-wide professional development and an AI playbook for students.',
  },
  {
    name: 'AI Energy + Ethics Lab at New Harmony',
    logo: '/media/ai-fes-logo-new-harmony.png',
    logoAlt: 'New Harmony High School logo',
    body: 'A grant to New Harmony High School is purchasing computers for an AI lab. Teacher Sean Muggivan will use it for curriculum focused on AI energy and ethics.',
  },
  {
    name: 'Khan Academy Subscriptions',
    logo: '/media/ai-fes-logo-khanmigo.png',
    logoAlt: 'Khanmigo logo',
    body: '2,000+ Khanmigo subscriptions were purchased for students at Bethune Elementary, Warren Easton High School, and Benjamin Franklin High School.',
  },
];

const SCHOOLS = [
  'Benjamin Franklin High School', 'New Harmony High School', 'ReNEW Schools', 'KIPP High Schools',
  'Audubon Schools', 'Isidore Newman', 'Bethune Elementary', 'Warren Easton High School',
];

// Real press coverage, linked out - thumbnails downloaded from the org's
// prior site rather than re-hosting the articles themselves.
const PRESS = [
  {
    img: '/media/ai-fes-press-fox8.jpg',
    title: 'AI Comes to NOLA Charter School',
    source: 'Fox 8 News',
    url: 'https://www.fox8live.com/2025/09/04/ai-comes-new-orleans-charter-school/',
  },
  {
    img: '/media/ai-fes-press-nola-ethics.jpg',
    title: 'A Louisiana school is teaching AI ethics',
    source: 'NOLA.com',
    url: 'https://www.nola.com/news/education/louisiana-school-ai-ethics/article_ac0af443-2152-4a9d-9c9b-5664e1d5d7c0.html',
  },
  {
    img: '/media/ai-fes-press-nola-committee.jpg',
    title: 'New committee to research impact of AI in Louisiana schools',
    source: 'NOLA.com',
    url: 'https://www.nola.com/news/education/new-committee-to-research-impact-of-ai-in-louisiana-schools/article_619d34c5-c770-47cd-9e02-2396bf63ab8d.html',
  },
];
---
<PageLayout title={title} description={description} canonical={canonical} image={image} current="ai-for-every-student">
  <section
    slot="hero"
    class="page-hero page-hero-photo"
    aria-label="AI for Every Student"
    style={`background-image: linear-gradient(to top, rgba(20,14,6,0.85), rgba(20,14,6,0.25) 60%), url(${HERO_IMAGE});`}
  >
    <div class="page-hero-inner">
      <p class="page-eyebrow">AI Literacy Initiative</p>
      <h1 class="page-hero-title">AI for Every Student</h1>
      <p class="page-hero-sub">
        Graduate Louisiana's <strong>650,000+</strong> digital citizens ready to win the <strong>$4.4 Trillion</strong> AI tech future.
      </p>
    </div>
  </section>

  <div class="page-block about-intro page-block-center">
    <p class="page-lede">
      Classrooms fall behind innovation cycles, leaving students unprepared for the modern workforce.
      AI for Every Student brings AI literacy to K-12 students, starting with Louisiana's 650,000+ students &mdash;
      providing coaching, professional development, and AI tools directly in classrooms. Each November at NOAI,
      participants share their work and experiences, with the ultimate goal of safe and effective AI implementation
      in schools everywhere.
    </p>
    <div class="page-cta-row">
      <a class="btn-primary" href="/ai-for-every-student/ai-futures/">Explore AI Futures Workshops</a>
      <a class="btn-outline" href="mailto:ai@philosophers.group">Bring This to Your School</a>
    </div>
    <div class="about-stats">
      <div class="about-stat">
        <p class="about-stat-num">650k+</p>
        <p class="about-stat-label">Louisiana Students</p>
      </div>
      <div class="about-stat">
        <p class="about-stat-num">8</p>
        <p class="about-stat-label">Schools Reached</p>
      </div>
      <div class="about-stat">
        <p class="about-stat-num">2,000+</p>
        <p class="about-stat-label">Khanmigo Licenses Funded</p>
      </div>
    </div>
  </div>

  <div class="page-block">
    <h2 class="page-section-heading">Impact Initiatives</h2>
    <div class="initiative-grid">
      {INITIATIVES.map((item) => (
        <div class="initiative-card">
          <img class="initiative-logo" src={item.logo} alt={item.logoAlt} loading="lazy" />
          <div class="initiative-body">
            <p class="initiative-name">{item.name}</p>
            <p class="initiative-text">{item.body}</p>
          </div>
        </div>
      ))}
    </div>
  </div>

  <div class="page-block">
    <h2 class="page-section-heading">Schools Supported</h2>
    <ul class="tag-pills">
      {SCHOOLS.map((name) => <li class="tag-pill">{name}</li>)}
    </ul>
    <p class="page-lede" style="font-size: 14px; color: var(--text-muted);">
      $13,000 is the average cost for a school to kickstart AI literacy. Interested schools should email{' '}
      <a href="mailto:ai@philosophers.group">ai@philosophers.group</a>.
    </p>
  </div>

  <div class="page-block">
    <h2 class="page-section-heading">In the News</h2>
    <div class="press-grid">
      {PRESS.map((p) => (
        <a class="press-card" href={p.url} target="_blank" rel="noopener">
          <img src={p.img} alt="" loading="lazy" />
          <div class="press-card-body">
            <p class="press-card-title">{p.title}<span class="sr-only"> (opens in a new window)</span></p>
            <p class="press-card-source">{p.source}</p>
          </div>
        </a>
      ))}
    </div>
  </div>

  <div class="page-block">
    <h2 class="page-section-heading">Current Funders</h2>
    <ul class="tag-pills">
      {FUNDERS.map((name) => <li class="tag-pill">{name}</li>)}
    </ul>
  </div>

  <div class="page-block">
    <h2 class="page-section-heading">Leadership</h2>
    <div class="about-org">
      <div class="about-org-text">
        <p>
          <strong>Blake Bertuccelli-Booth</strong> leads AI for Every Student, with over a decade of experience in
          technology companies and nonprofits expanding access to information. He serves on the LASTEM advisory
          council and the BESE AI Work Group.
        </p>
        <p>
          A campaign supports Louisiana's Board of Education in promoting AI literacy at <a href="https://laleadsai.org/" target="_blank" rel="noopener">LAleadsAI.org<span class="sr-only"> (opens in a new window)</span></a>.
        </p>
        <div class="page-cta-row">
          <a class="btn-outline" href="mailto:blake@philosophers.group">Contact Blake</a>
        </div>
      </div>
      <figure class="about-org-photo">
        <img src="/media/ai-fes-blake-leadership.jpg" alt="Blake Bertuccelli-Booth, wearing an NOAI t-shirt and blazer, gestures while speaking during an interview." loading="lazy" />
      </figure>
    </div>
  </div>

  <div class="contact-card">
    Want to get involved? Contact <a href="mailto:ai@philosophers.group">ai@philosophers.group</a>.
  </div>
</PageLayout>

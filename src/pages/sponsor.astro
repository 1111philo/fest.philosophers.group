---
import PageLayout from '../layouts/PageLayout.astro';
import PageHero from '../components/PageHero.astro';
import { loadContent, pageMeta, SITE_TITLE } from '../lib/content.mjs';

const meta = pageMeta(loadContent(), 620, 'sponsor');
meta.title = `Sponsor — ${SITE_TITLE}`;
meta.description = 'Sponsor NOAI: Arts & Ideas Festival in New Orleans. Past speakers have come from Google DeepMind, IBM, Adobe, Tulane University, and LSU.';

const PAST_SPEAKERS = ['Google DeepMind', 'IBM', 'Adobe', 'Tulane University', 'LSU'];

const TIERS = [
  {
    name: 'Community Sponsor',
    short: 'Community',
    price: '$500',
    stripeUrl: 'https://buy.stripe.com/6oU6oG9fz7rzdFB2hw7Zu0h',
    benefits: [
      'Logo on the event website and thank-you slides',
      'Recognition in the event program',
      'Two complimentary registrations',
      'Two invites to the sponsor event',
    ],
  },
  {
    name: 'Exhibiting Sponsor',
    short: 'Exhibiting',
    price: '$1,500',
    stripeUrl: 'https://buy.stripe.com/4gM14m1N74fngRNg8m7Zu0i',
    benefits: [
      '30-minute presentation slot',
      'Logo on the event program, website, emails, and thank-you slides',
      'Contact information from attendees who opt in',
      'Three complimentary registrations',
      'Five invites to the sponsor event',
    ],
  },
  {
    name: 'Premier Sponsor',
    short: 'Premier',
    price: '$2,500',
    stripeUrl: 'https://buy.stripe.com/eVqeVc4Zj6nvcBxbS67Zu0j',
    benefits: [
      '60-minute presentation slot',
      'Premier logo placement on the event program, website, emails, and thank-you slides',
      'Contact information from attendees who opt in',
      'Dedicated sponsor thank-you email',
      'Ten complimentary registrations',
      'Ten invites to the sponsor event',
    ],
  },
  {
    name: 'Title Sponsor',
    short: 'Title',
    price: '$11,000',
    stripeUrl: 'https://buy.stripe.com/eVq14mbnH8vDeJF1ds7Zu0k',
    limited: 'Only 1 available',
    benefits: [
      'Everything in Premier Sponsor',
      'A curated presentation slot on opening day',
      'Top logo placement on the event program, website, emails, and thank-you slides',
      'Named as Title Sponsor in all festival announcements and press',
    ],
  },
];
---
<PageLayout title={meta.title} description={meta.description} canonical={meta.canonical} image={meta.image.url} current="sponsor">
  <PageHero slot="hero" label="Sponsorship" eyebrow="Sponsorship" title="Sponsor the Festival" accent="red" art="sun">
    <p class="page-hero-sub">Past speakers have come from:</p>
    <ul class="speaker-list">
      {PAST_SPEAKERS.map((name) => <li>{name}</li>)}
    </ul>
  </PageHero>

  <section class="swiss-split" aria-labelledby="sponsor-why">
    <p class="section-index" aria-hidden="true">01</p>
    <div class="swiss-split-body">
      <h2 class="page-section-heading" id="sponsor-why">Why Sponsor</h2>
      <p class="page-lede">
        Sponsors get a presentation slot, logo placement, and complimentary registrations and event invites.
        Higher tiers also get attendee contact information for opted-in attendees. Details for each tier are below.
      </p>
    </div>
  </section>

  <ul class="about-stats" aria-label="Sponsorship at a glance">
    <li class="about-stat">
      <p class="about-stat-num">{TIERS.length}</p>
      <p class="about-stat-label">Sponsorship Tiers</p>
    </li>
    <li class="about-stat">
      <p class="about-stat-num">$500<span class="stat-plus">+</span></p>
      <p class="about-stat-label">Starting Price</p>
    </li>
    <li class="about-stat">
      <p class="about-stat-num">60 min</p>
      <p class="about-stat-label">Stage Time Included</p>
    </li>
  </ul>

  <section class="page-block" aria-labelledby="sponsor-levels">
    <div class="section-head">
      <p class="section-index" aria-hidden="true">02</p>
      <h2 class="page-section-heading" id="sponsor-levels">Sponsorship Levels</h2>
    </div>
    <div class="tier-grid">
      {TIERS.map((tier, i) => (
        <div class={`tier-card tier-card-${i + 1}${tier.limited ? ' tier-card-featured' : ''}`}>
          <div class="tier-band" aria-hidden="true">
            <span class="squiggle tier-squiggle"></span>
          </div>
          <div class="tier-content">
            <h3 class="tier-name">{tier.name}</h3>
            <p class="tier-price">{tier.price}</p>
            {tier.limited && <p class="tier-limited">{tier.limited}</p>}
            <ul class="tier-list">
              {tier.benefits.map((b) => <li>{b}</li>)}
            </ul>
            <a class="btn-primary tier-buy" href={tier.stripeUrl} target="_blank" rel="noopener">
              Purchase {tier.short}<span class="sr-only"> (opens in a new window)</span>
            </a>
          </div>
        </div>
      ))}
    </div>
  </section>

  <div class="contact-card contact-card-block">
    <div class="squiggle-field contact-card-field" aria-hidden="true"></div>
    <p class="contact-card-text">
      Questions? Contact <a href="mailto:fest@philosophers.group">fest@philosophers.group</a>.
    </p>
  </div>
</PageLayout>

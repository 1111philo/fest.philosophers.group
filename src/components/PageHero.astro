---
// Poster-style page hero shared by every standalone page: a heavy
// grotesk title on the left, and on the right either a photo (framed by
// an offset color block, like a Swiss poster's overprinted plates) or -
// with no photo - one of the brand's abstract compositions (`art`), or by
// default a field of the logo's squiggles with its ringed red dot.
// `accent` picks which of the logo's colors the offset block/bar uses, so
// neighboring pages don't all look identical.
import AbstractArt from './AbstractArt.astro';

interface Props {
  label: string;
  eyebrow?: string;
  title: string;
  image?: string;
  imageAlt?: string;
  accent?: 'blue' | 'yellow' | 'red' | 'teal';
  art?: 'field' | 'sun' | 'target' | 'dots' | 'rows' | 'shapes';
}

const { label, eyebrow, title, image, imageAlt = '', accent = 'blue', art } = Astro.props;
---
<section class={`hero hero-accent-${accent}${image ? ' hero-has-photo' : ''}`} aria-label={label}>
  <div class="hero-inner">
    <div class="hero-text">
      {eyebrow && <p class="hero-eyebrow">{eyebrow}</p>}
      <h1 class="hero-title">{title}</h1>
      <slot />
    </div>
    <div class="hero-art">
      {image ? (
        imageAlt ? (
          <figure class="hero-photo">
            <img src={image} alt={imageAlt} />
            <span class="ring-dot hero-photo-dot" aria-hidden="true"></span>
          </figure>
        ) : (
          <div class="hero-photo">
            <img src={image} alt="" />
            <span class="ring-dot hero-photo-dot" aria-hidden="true"></span>
          </div>
        )
      ) : art ? (
        <AbstractArt name={art} class="hero-abstract" />
      ) : (
        <div class="hero-field" aria-hidden="true">
          <div class="squiggle-field"></div>
          <span class="hero-bar"></span>
          <span class="ring-dot hero-field-dot"></span>
        </div>
      )}
    </div>
  </div>
</section>

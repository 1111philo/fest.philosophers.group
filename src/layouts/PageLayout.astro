---
import SiteHeader from '../components/SiteHeader';
import SiteFooter from '../components/SiteFooter.astro';
import { SITE_TITLE } from '../lib/content.mjs';
import '../styles/app.css';

interface Props {
  title: string;
  description: string;
  canonical: string;
  image: string;
  current: string;
}

const { title, description, canonical, image, current } = Astro.props;
---
<!doctype html>
<html lang="en">
<head>
<meta charset="UTF-8">
<script is:inline>
  // The header logo's intro animation (styles/app.css, .logo-intro) plays
  // once per visit, not on every page load.
  try {
    if (!sessionStorage.getItem('noai-logo-intro')) {
      sessionStorage.setItem('noai-logo-intro', '1');
      document.documentElement.classList.add('logo-intro');
    }
  } catch (e) { /* storage blocked - skip the intro */ }
</script>
<meta name="theme-color" content="#f3eddc" media="(prefers-color-scheme: light)">
<meta name="theme-color" content="#161513" media="(prefers-color-scheme: dark)">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<base href="/">
<title>{title}</title>
<meta name="description" content={description}>
<link rel="canonical" href={canonical}>
<link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png">
<link rel="icon" href="/favicon-192.png" sizes="192x192" type="image/png">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<meta property="og:type" content="website">
<meta property="og:site_name" content={SITE_TITLE}>
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:url" content={canonical}>
<meta property="og:image" content={image}>
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content={title}>
<meta name="twitter:description" content={description}>
<meta name="twitter:image" content={image}>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter+Tight:wght@500;600;700;800;900&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<slot name="head" />
</head>
<body>
<a class="skip-link" href={`${Astro.url.pathname}#main`}>Skip to content</a>
<script is:inline>
  // <base href="/"> makes a bare "#main" resolve to the homepage, so the
  // link carries the page's own path - but the build-time path is wrong on
  // the 404 page (served at any missing URL) and drops the schedule's
  // filter query, so point it at wherever the visitor actually is.
  document.currentScript.previousElementSibling.href = location.pathname + location.search + '#main';
</script>
<SiteHeader client:load current={current} titleIsHeading={false} />
<main id="main" tabindex="-1">
  <slot name="hero" />
  <div class="page-main">
    <slot />
  </div>
</main>
<SiteFooter />
<script is:inline>
  // First-view reveals (styles in app.css, "First-view reveals"): stat
  // blocks and the gallery play once when they first scroll into view;
  // dialogue lines and project rows reveal one at a time as they arrive,
  // queued so a fast scroll still plays them in sequence. Skipped entirely
  // under reduced motion or without IntersectionObserver - then everything
  // just shows.
  (function () {
    if (!('IntersectionObserver' in window) || matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    // Count a stat number up to its value. The visible digits are
    // aria-hidden; screen readers get the final text from a sr-only copy.
    function countUp(el, delay) {
      var node = Array.prototype.find.call(el.childNodes, function (n) { return n.nodeType === 3 && /\d/.test(n.nodeValue); });
      if (!node) return;
      var m = /^(\D*)([\d,]+)(.*)$/.exec(node.nodeValue.trim());
      if (!m) return;
      var pre = m[1], digits = m[2], suf = m[3];
      var target = Number(digits.replace(/,/g, ''));
      var commas = digits.indexOf(',') !== -1;
      var isYear = target >= 1900 && target <= 2100;
      var from = isYear ? target - 25 : 0;
      var fmt = function (v) { return pre + (commas ? v.toLocaleString('en-US') : String(v)) + suf; };
      var shown = document.createElement('span');
      shown.setAttribute('aria-hidden', 'true');
      shown.textContent = fmt(from);
      var spoken = document.createElement('span');
      spoken.className = 'sr-only';
      spoken.textContent = node.nodeValue;
      el.replaceChild(shown, node);
      el.insertBefore(spoken, shown);
      var duration = isYear ? 1000 : 1400;
      setTimeout(function () {
        var start;
        requestAnimationFrame(function step(t) {
          if (start === undefined) start = t;
          var p = Math.min(1, (t - start) / duration);
          var eased = 1 - Math.pow(1 - p, 3);
          shown.textContent = fmt(Math.round(from + (target - from) * eased));
          if (p < 1) requestAnimationFrame(step);
        });
      }, delay);
    }

    var groups = document.querySelectorAll('.about-stats, .page-gallery');
    var groupObserver = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        if (!entry.isIntersecting) return;
        var g = entry.target;
        groupObserver.unobserve(g);
        g.classList.remove('reveal-pending');
        g.classList.add('reveal-in');
        if (g.classList.contains('about-stats')) {
          g.querySelectorAll('.about-stat').forEach(function (stat, i) {
            if (i % 4 === 1 || i % 4 === 3) countUp(stat.querySelector('.about-stat-num'), 140 * i + 150);
          });
        }
      });
    }, { threshold: 0.35 });
    groups.forEach(function (g) { g.classList.add('reveal-pending'); groupObserver.observe(g); });

    var items = document.querySelectorAll('.about-quote-line, .about-quote-cap, .org-project-list li');
    var nextAt = 0;
    var itemObserver = new IntersectionObserver(function (entries) {
      entries.filter(function (e) { return e.isIntersecting; })
        .sort(function (a, b) { return a.boundingClientRect.top - b.boundingClientRect.top; })
        .forEach(function (entry) {
          var el = entry.target;
          itemObserver.unobserve(el);
          var now = performance.now();
          var at = Math.max(now, nextAt);
          nextAt = at + 170;
          setTimeout(function () { el.setAttribute('data-reveal', 'in'); }, at - now);
        });
    }, { rootMargin: '0px 0px -12% 0px' });
    items.forEach(function (el) { el.setAttribute('data-reveal', 'pending'); itemObserver.observe(el); });
  })();
</script>
</body>
</html>
